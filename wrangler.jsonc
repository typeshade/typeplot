// TypeNN hosting convention: Astro static assets, custom domain only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typeplot-site",
  "account_id": "7c029c2ac777ff3c45a4bcbe67918a1e",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [{ "pattern": "plot.typeshade.dev", "custom_domain": true }],
  "assets": {
    "directory": "./website/dist",
    "not_found_handling": "404-page",
  },
}
