---
import ThemeControl from "../components/ThemeControl";
import "../styles/global.css";
interface Props { locale: "en" | "ko"; active: string; title: string; description: string; }
const { locale, active, title, description } = Astro.props;
const ko = locale === "ko";
const base = ko ? "/ko" : "";
const links = [
  {key:"home",path:"/",en:"Overview",ko:"TypePlot 소개"},
  {key:"guide",path:"/guide/",en:"Get started",ko:"시작하기"},
  {key:"gpu",path:"/guide/gpu/",en:"GPU functions",ko:"GPU 함수"},
  {key:"api",path:"/api/",en:"API reference",ko:"API 참조"},
  {key:"playground",path:"/playground/",en:"Playground",ko:"직접 실행"},
  {key:"examples",path:"/examples/",en:"Examples",ko:"예제"},
];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const enPath = ko ? Astro.url.pathname.replace(/^\/ko/, "") || "/" : Astro.url.pathname;
const koPath = `/ko${enPath}`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1677ff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site).href} />
    <link rel="alternate" hreflang="ko" href={new URL(koPath, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site).href} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      try { const saved = localStorage.getItem("typeplot-theme"); document.documentElement.dataset.theme = saved === "dark" || (saved !== "light" && matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light"; } catch { document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ko ? "본문으로 건너뛰기" : "Skip to content"}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`${base}/`}><img src="/mark.svg" width="28" height="28" alt="" /><span>TypePlot</span></a>
        <nav class="top-nav" aria-label={ko ? "주 메뉴" : "Primary navigation"}>
          {links.filter(link => !["home","gpu"].includes(link.key)).map(link => <a class:list={["top-link",active === link.key && "is-active"]} href={`${base}${link.path}`} aria-current={active === link.key ? "page" : undefined}>{ko ? link.ko : link.en}</a>)}
        </nav>
        <div class="header-tools">
          <a class="language-link" href={ko ? enPath : koPath} lang={ko ? "en" : "ko"}>{ko ? "English" : "한국어"}</a>
          <ThemeControl client:load darkLabel={ko ? "어두운 테마" : "Dark theme"} lightLabel={ko ? "밝은 테마" : "Light theme"} />
        </div>
      </div>
    </header>
    <div class:list={["page-frame",active === "home" && "home-frame"]}>
      {active !== "home" && <aside class="docs-sidebar" aria-label={ko ? "문서 탐색" : "Documentation navigation"}>
        <a class="sidebar-home" href={`${base}/`}>{ko ? "TypePlot 문서" : "TypePlot docs"}</a>
        <div class="sidebar-group"><p class="sidebar-heading">{ko ? "문서와 실습" : "Docs & practice"}</p>
          {links.filter(link => link.key !== "home").map(link => <a class:list={["sidebar-link",active === link.key && "is-active"]} href={`${base}${link.path}`} aria-current={active === link.key ? "page" : undefined}>{ko ? link.ko : link.en}</a>)}
        </div>
        <a class="sidebar-source" href="https://github.com/typeshade/typeplot">{ko ? "소스 코드 ↗" : "Source code ↗"}</a>
      </aside>}
      <main id="main" class="site-main"><slot /></main>
    </div>
    <footer class="site-footer"><div class="footer-inner">
      <span>{ko ? "TypeScript로 데이터를 그리고, TypeShade로 GPU 함수를 실행합니다." : "Plot data in TypeScript. Run GPU functions with TypeShade."}</span>
      <div><a href="https://github.com/typeshade/typeplot">GitHub</a><a href="https://github.com/typeshade/typeplot/tree/site/typeplot-website/website">{ko ? "사이트 소스" : "Website source"}</a><a href="https://nn.typeshade.dev">TypeNN</a><a href="https://typeshade.dev">TypeShade</a></div>
    </div></footer>
  </body>
</html>
